<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RazorPagesMovie - Catálogo profissional de filmes com ASP.NET Core Razor Pages e .NET 10" />
    <meta name="author" content="Rafael Batista" />
    <meta name="theme-color" content="#0d6efd" />
    <title>@ViewData["Title"] — RazorPagesMovie</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bootstrap Icons CDN (lightweight, only what's needed) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorPagesMovie.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <i class="bi bi-film"></i> RazorPagesMovie
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Movies/Index">
                                <i class="bi bi-collection-play"></i> Filmes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Privacy">
                                <i class="bi bi-shield-check"></i> Privacidade
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span>@successMsg</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        </div>
    }

    <main role="main" class="flex-shrink-0 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-4 bg-dark text-light">
        <div class="container">
            <div class="row g-3">
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-film"></i> RazorPagesMovie</h5>
                    <p class="text-secondary small mb-0">
                        Catálogo profissional de filmes desenvolvido com
                        <strong>ASP.NET Core Razor Pages</strong> e <strong>.NET 10</strong>.
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-semibold">Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-page="/Movies/Index" class="text-decoration-none text-secondary">Catálogo</a></li>
                        <li><a asp-page="/Privacy" class="text-decoration-none text-secondary">Privacidade</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-semibold">Tecnologias</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li>.NET 10</li>
                        <li>ASP.NET Core</li>
                        <li>Entity Framework Core</li>
                        <li>SQLite</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-3" />
            <div class="row">
                <div class="col text-center">
                    <p class="small text-secondary mb-0">
                        &copy; @DateTime.Now.Year — <strong>RazorPagesMovie</strong> by Rafael Batista.
                        Todos os direitos reservados.
                        <a asp-page="/Privacy" class="text-decoration-none text-secondary ms-2">Privacidade</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
