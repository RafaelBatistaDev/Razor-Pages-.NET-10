@page
@model RazorPagesMovie.Pages.Movies.DeleteModel
@{
    ViewData["Title"] = "Excluir Filme";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Movies/Index">Filmes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Excluir</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 border-danger">
        <div class="card-header bg-danger-subtle border-0">
            <h1 class="h3 mb-0 text-danger">
                <i class="bi bi-exclamation-triangle"></i> Confirmar Exclusão
            </h1>
        </div>
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-info-circle"></i>
                Você tem certeza que deseja excluir o filme <strong>@Model.Movie.Title</strong>?
                Esta ação não pode ser desfeita.
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <h6 class="fw-semibold text-muted small text-uppercase">Título</h6>
                    <p>@Model.Movie.Title</p>
                </div>

                <div class="col-md-3">
                    <h6 class="fw-semibold text-muted small text-uppercase">Gênero</h6>
                    <p>@Model.Movie.Genre</p>
                </div>

                <div class="col-md-3">
                    <h6 class="fw-semibold text-muted small text-uppercase">Preço</h6>
                    <p>@Model.Movie.Price.ToString("C2")</p>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-semibold text-muted small text-uppercase">Data de Lançamento</h6>
                    <p>@Model.Movie.ReleaseDate.ToString("dd/MM/yyyy")</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Movie.Director))
                {
                    <div class="col-md-6">
                        <h6 class="fw-semibold text-muted small text-uppercase">Diretor</h6>
                        <p>@Model.Movie.Director</p>
                    </div>
                }
            </div>

            <form method="post">
                <input type="hidden" asp-for="Movie.Id" />
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash"></i> Sim, Excluir
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary px-4 ms-2">
                    <i class="bi bi-x-lg"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>
